{
  "expo": {
    "name": "Lumen",
    "slug": "lumen-camera",
    "scheme": "lumen",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0C",
    "ios": {
      "bundleIdentifier": "app.lumencamera.ios",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Lumen uses the camera so you can take photos with live filters. Photos stay on your device.",
        "NSPhotoLibraryAddUsageDescription": "Lumen saves the photos you take and edit to your photo library.",
        "NSPhotoLibraryUsageDescription": "Lumen lets you pick photos from your library to edit. Photos are never uploaded.",
        "NSUserTrackingUsageDescription": "Allowing tracking lets ads be more relevant. Lumen works the same either way.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.lumencamera.android",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Lumen lets you pick photos from your library to edit. Photos are never uploaded.",
          "savePhotosPermission": "Lumen saves the photos you take and edit to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "Allowing tracking lets ads be more relevant. Lumen works the same either way."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Allowing tracking lets ads be more relevant. Lumen works the same either way."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildArchs": [
              "arm64-v8a"
            ]
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0C"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "websiteUrl": "https://lumen-camera-mu.vercel.app",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "aea6199d-d364-44a0-aa53-00e98bd83142"
      }
    },
    "owner": "kunalpatro"
  }
}
