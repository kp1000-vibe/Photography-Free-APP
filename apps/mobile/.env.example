# Ads mode: "off" | "test" | "production". Development builds default to "test".
EXPO_PUBLIC_ADS_MODE=test
# Production AdMob ad unit IDs (public identifiers, not secrets). Leave empty until AdMob is set up.
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
